{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Current File To Base64",
			"command": "${cwd}/toBase64.ps1",
			"type": "shell",
			"args": [
				{
					"quoting": "strong",
					"value": "${relativeFile}"
				},
				{
					"quoting": "strong",
					"value": "${fileDirname}/base64.txt"
				},
			],
			"problemMatcher": [
				"$tsc"
			],
			"presentation": {
				"reveal": "always"
			},
			"group": "build"
		}
	]
}